{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome (Current HTML File)",
            "type": "chrome",
            "request": "launch",
            "file": "${file}"
        },
        {
            "name": "Launch Chrome (index.html)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Launch Chrome (Live Server port 5500)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/${relativeFile}",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome (localhost:8080)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080/${relativeFile}",
            "webRoot": "${workspaceFolder}"
        }
    ]
}